# Multi-stage build for the clustered agent-workflow example.
#
# Build from the WORKSPACE ROOT (the build context must include the whole Cargo
# workspace, since the example depends on path crates):
#
#   docker build -f examples/clustered-agent-workflow-http-grpc/Dockerfile \
#     -t rakka-agent-workflow-http-grpc:0.1.0 .
#
# `protoc` is required at build time only (the gRPC contract is generated by
# tonic-build). The image is built with the `postgres` feature so a Kubernetes
# deployment can use the shared PostgreSQL durable store.

FROM rust:1.83-bookworm AS builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . .
RUN cargo build --release \
    -p rakka-example-clustered-agent-workflow-http-grpc \
    --features postgres

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder \
    /workspace/target/release/rakka-example-clustered-agent-workflow-http-grpc \
    /usr/local/bin/agent-workflow
# remoting (rakka-remote) / HTTP ingress / gRPC ingress
EXPOSE 25530 35530 45530
ENTRYPOINT ["/usr/local/bin/agent-workflow"]
# Override with ["grpc"] to expose the gRPC ingress instead.
CMD ["http"]
